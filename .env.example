# External Client App consumer key (required)
SF_CLIENT_ID=

# login.salesforce.com | test.salesforce.com | https://yourdomain.my.salesforce.com
SF_LOGIN_HOST=https://login.salesforce.com

# Optional: full Hosted MCP URL. If unset, built from SF_MCP_SANDBOX + SF_MCP_SERVER.
# Production: https://api.salesforce.com/platform/mcp/v1/platform/sobject-all
# Sandbox:    https://api.salesforce.com/platform/mcp/v1/sandbox/platform/sobject-all
# SF_MCP_URL=

# true = sandbox/scratch URL path; false = production
SF_MCP_SANDBOX=false

# Hosted MCP server name path segment(s)
SF_MCP_SERVER=platform/sobject-all

# Must match a Callback URL on the External Client App
SF_REDIRECT_URI=http://localhost:8765/callback

# Where refresh/access tokens are stored
# SF_TOKEN_PATH=~/.salesforce-mcp-bridge/tokens.json
